{
  "info": {
    "name": "authh - API Usuarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "usuarioId", "value": "", "type": "string" },
    { "key": "correo", "value": "", "type": "string" },
    { "key": "clave", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. POST save",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';",
              "let clave = '';",
              "for (let i = 0; i < 9; i++) {",
              "    clave += chars.charAt(Math.floor(Math.random() * chars.length));",
              "}",
              "pm.collectionVariables.set('clave', clave);",
              "pm.collectionVariables.set('correo', 'u' + (Date.now() % 1000000) + '@t.co');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Devuelve un id generado', function () {",
              "    pm.expect(pm.response.json().id).to.not.be.null;",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set('usuarioId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Esteban\",\n  \"correo\": \"{{correo}}\",\n  \"clave\": \"{{clave}}\",\n  \"rol\": \"USER\",\n  \"numerodecelular\": \"3001234567\",\n  \"edad\": 20\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/ecommerce/usuario/save",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "ecommerce", "usuario", "save" ]
        }
      }
    },
    {
      "name": "2. GET por id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Es el usuario pedido', function () {",
              "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('usuarioId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ecommerce/usuario/{{usuarioId}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "ecommerce", "usuario", "{{usuarioId}}" ]
        }
      }
    },
    {
      "name": "3. PUT update",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Guardó los cambios', function () {",
              "    pm.expect(pm.response.json().nombre).to.eql('Esteban Editado');",
              "    pm.expect(pm.response.json().rol).to.eql('ADMIN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{usuarioId}}\",\n  \"nombre\": \"Esteban Editado\",\n  \"correo\": \"{{correo}}\",\n  \"clave\": \"{{clave}}\",\n  \"rol\": \"ADMIN\",\n  \"numerodecelular\": \"3009999999\",\n  \"edad\": 21\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/ecommerce/usuario/update",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "ecommerce", "usuario", "update" ]
        }
      }
    },
    {
      "name": "4. POST login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Confirma el logueo', function () {",
              "    pm.expect(pm.response.text()).to.include('exitosamente');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"clave\": \"{{clave}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/ecommerce/usuario/login",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "ecommerce", "usuario", "login" ]
        }
      }
    },
    {
      "name": "5. DELETE por id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Confirma el borrado', function () {",
              "    pm.expect(pm.response.text()).to.include('eliminado');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ecommerce/usuario/{{usuarioId}}",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "ecommerce", "usuario", "{{usuarioId}}" ]
        }
      }
    }
  ]
}
