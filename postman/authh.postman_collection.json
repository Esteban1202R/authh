{
  "info": {
    "name": "authh - API Usuarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "claveAleatoria",
      "value": "",
      "type": "string"
    },
    {
      "key": "correoAleatorio",
      "value": "",
      "type": "string"
    },
    {
      "key": "ultimoUsuarioId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Caso valido",
      "item": [
        {
          "name": "Guardar usuario valido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const chars = 'abcdefghijkmnpqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789';",
                  "let clave = '';",
                  "for (let i = 0; i < 10; i++) {",
                  "    clave += chars.charAt(Math.floor(Math.random() * chars.length));",
                  "}",
                  "pm.collectionVariables.set('claveAleatoria', clave);",
                  "pm.collectionVariables.set('correoAleatorio', 'u' + (Date.now() % 1000000) + '@t.co');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Devuelve el usuario con un id generado', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.not.be.null;",
                  "    pm.expect(body.id).to.be.a('string').and.to.have.length.above(0);",
                  "});",
                  "",
                  "pm.test('Conserva los datos enviados', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.nombre).to.eql('Esteban');",
                  "    pm.expect(body.edad).to.eql(20);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('ultimoUsuarioId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Esteban\",\n  \"correo\": \"{{correoAleatorio}}\",\n  \"clave\": \"{{claveAleatoria}}\",\n  \"rol\": \"USER\",\n  \"numerodecelular\": \"3001234567\",\n  \"edad\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/ecommerce/usuario/save",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ecommerce",
                "usuario",
                "save"
              ]
            }
          }
        }
      ]
    },
